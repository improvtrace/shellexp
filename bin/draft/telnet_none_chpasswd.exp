#!/usr/bin/expect
# ============================================================
# ShellExp 生成的 expect 脚本 —— 构建产物, 请勿手工编辑
# 组合: auth=telnet escalate=none biz=chpasswd
# 重新生成: ./main.sh --auth telnet --escalate none --biz chpasswd --out /home/administrator/projects/shellexp/bin/draft/telnet_none_chpasswd.exp
# 生成时间: 2026-09-03 18:36:00
# ============================================================


# ------------------------------------------------------------
# 段0 公共头 · 超时（可用环境变量 TIMEOUT 覆盖, 默认 30 秒）
# ------------------------------------------------------------
set timeout 30
if {[info exists env(TIMEOUT)]} { set timeout $env(TIMEOUT) }

proc usage {} {
    global argv0
    puts stderr "Usage: AUTH_PASS=... NEW_PASS=... $argv0 <host> <port> <auth_user> <target_user>"
    puts stderr ""
    puts stderr "Positional args:"
    puts stderr "  host         target host address"
    puts stderr "  port         telnet port (e.g. 23)"
    puts stderr "  auth_user    login username"
    puts stderr "  target_user  user whose password to change"

    puts stderr ""
    puts stderr "Environment variables:"
    puts stderr "  AUTH_PASS        SSH/telnet login password (required)"
    puts stderr "  NEW_PASS         new password (required)"
    puts stderr "  TIMEOUT          expect timeout in seconds (optional, default 30)"
    puts stderr "  PROXYCHAINS_CONF proxychains4 config file path (maintained by caller); when set, telnet runs wrapped as \"proxychains4 -q -f <conf> telnet\" (optional)"

    exit 1
}

# 运行时校验: 缺少必需环境变量立即报错退出（凭据不进 argv, 防 ps 泄露）
foreach _v {AUTH_PASS NEW_PASS} {
    if {![info exists env($_v)]} {
        puts stderr "ERROR: missing required env var $_v"
        usage
    }
}

if {$argc != 4} { usage }
set host [lindex $argv 0]
set port [lindex $argv 1]
set auth_user [lindex $argv 2]
set target_user [lindex $argv 3]



# ------------------------------------------------------------
# 公共工具函数（源: script/lib/util.tcl, 拼装时内联）
# ------------------------------------------------------------
# ------------------------------------------------------------
# script/lib/util.tcl — 公共工具函数（拼装时内联进 bin/ 产物）
# ------------------------------------------------------------

# 带时间戳的日志，输出到 stderr（不污染 stdout，便于管道采集）
proc log_info {msg} {
    puts stderr "\[[clock format [clock seconds] -format %H:%M:%S]\] $msg"
}

# 报错退出：code 为分段语义退出码
proc die {code msg} {
    puts stderr "ERROR: $msg"
    exit $code
}

# POSIX 单引号转义：把值安全嵌入远端 shell 的单引号字符串
# 例：ab'cd -> ab'\''cd（拼回单引号串后还原为 ab'cd）
# 注意：映射表必须用 [list] 构造，大括号字面量会被 lindex 吃掉反斜杠
proc quote_single {s} {
    return [string map [list "'" "'\\''"] $s]
}

# ------------------------------------------------------------
# 段1 认证 · telnet —— Telnet 密码登录（全脚本唯一 spawn 点）
# REQUIRE_ENV: AUTH_PASS
# REQUIRE_ARGV: host target host address
# REQUIRE_ARGV: port telnet port (e.g. 23)
# REQUIRE_ARGV: auth_user login username
# OPT_ENV: PROXYCHAINS_CONF proxychains4 config file path (maintained by caller); when set, telnet runs wrapped as "proxychains4 -q -f <conf> telnet"
# 前置: 无
# 后置: 已到达远端 shell 提示符（locale 固定由公共帧完成，见 main.sh 段1.5）
# 退出码: 2 认证失败 / 连接不可达 / 超时 / 会话中断
# 安全警告: Telnet 明文传输凭据，仅限独立管理网/带外网使用（调研 5.4）
# 过代理说明: 框架仅提供 proxychains4 包裹能力，配置文件由调用者自行生成维护（内容零认知）；
#            proxychains4 对 telnet 的要求见 README「过代理连接」
# ------------------------------------------------------------

if {![info exists env(AUTH_PASS)]} { die 1 "missing env AUTH_PASS" }

if {[info exists env(PROXYCHAINS_CONF)] && $env(PROXYCHAINS_CONF) ne ""} {
    log_info "spawn proxychains4 -q -f $env(PROXYCHAINS_CONF) telnet $host $port"
    spawn proxychains4 -q -f $env(PROXYCHAINS_CONF) telnet $host $port
} else {
    log_info "spawn telnet $host $port (direct)"
    spawn telnet $host $port
}

set _login_tries 0
set _pass_tries 0
expect {
    -re {Connection refused|Unable to connect|No route to host|Network is unreachable|Connection timed out|Connection closed by foreign host} {
        puts stderr "AUTH_UNREACHABLE"
        exit 2
    }
    -re {(Login|Username|login)\s*[:：]\s*$} {
        # 登录名提示反复出现视为认证失败（单次失败即退出，防锁定）
        if {[incr _login_tries] > 1} { puts stderr "AUTH_DENIED"; exit 2 }
        log_info "login prompt hit, sending auth_user"
        send -- "$auth_user\r"
        exp_continue
    }
    -re {[Pp]assword\s*[:：]\s*$} {
        if {[incr _pass_tries] > 1} { puts stderr "AUTH_DENIED"; exit 2 }
        log_info "password prompt hit, sending AUTH_PASS"
        log_user 0
        send -- "$env(AUTH_PASS)\r"
        exp_continue
    }
    -re {Login incorrect|认证失败} {
        puts stderr "AUTH_DENIED"
        exit 2
    }
    -re {[%#$>]\s*$} {
        log_user 1
        log_info "auth ok, remote prompt reached"
    }
    timeout { puts stderr "AUTH_TIMEOUT"; exit 2 }
    eof     { puts stderr "AUTH_EOF";     exit 2 }
}

# ------------------------------------------------------------
# 段1.5 公共 · locale 固定 —— 认证成功后、提权/业务前执行；
# 统一远端提示语言，规避中文 locale 下的提示漂移（调研 4.4）。
# 注意: 要求远端为 POSIX shell；网络设备等非 shell 目标应在业务模板内处理。
# ------------------------------------------------------------
send "export LANG=C LC_ALL=C\r"
expect {
    -re {[%#$>]\s*$} { }
    timeout { puts stderr "LOCALE_TIMEOUT"; exit 2 }
    eof     { puts stderr "LOCALE_EOF";     exit 2 }
}
log_info "remote locale fixed to C"

# ------------------------------------------------------------
# 段2 提权 · none —— 空段：登录身份已满足业务权限
# ------------------------------------------------------------

# ------------------------------------------------------------
# 段3 业务 · password/chpasswd —— 非交互改密（首选路线，调研 6.1 路线 A）
# REQUIRE_ENV: NEW_PASS
# REQUIRE_ARGV: target_user user whose password to change
# 前置: 会话已具备 root 权限（直登 root 或经提权段）
# 判定: 以退出码标记 BIZRC_<ts>=rc 判定成败，规避回显/语言/发行版差异（调研 3.3）
# 退出码: 6 业务失败
# ------------------------------------------------------------

if {![info exists env(NEW_PASS)]} { die 1 "missing env NEW_PASS" }

set _tu [quote_single $target_user]
set _np [quote_single $env(NEW_PASS)]
set _marker "BIZRC_[clock clicks]"

log_info "biz: chpasswd for $target_user"
# 命令行内嵌密码：先关回显再 send，防止密码进入屏幕/会话日志（调研 6.5）
log_user 0
send "echo '$_tu:$_np' | chpasswd; echo $_marker=\$?\r"

expect {
    -re "$_marker=(\[0-9\]+)" {
        log_user 1
        set _rc $expect_out(1,string)
        if {$_rc == 0} {
            log_info "biz: password changed for $target_user (rc=0)"
        } else {
            puts stderr "BIZ_FAIL: chpasswd rc=$_rc"
            exit 6
        }
    }
    timeout { log_user 1; puts stderr "BIZ_TIMEOUT"; exit 6 }
    eof     { log_user 1; puts stderr "BIZ_EOF";     exit 6 }
}


# ------------------------------------------------------------
# 段4 收尾 · epilogue —— 逐层退出嵌套 shell 直至 eof
# ------------------------------------------------------------
log_info "epilogue: exiting session"
foreach _i {1 2 3 4 5} {
    expect {
        eof     { break }
        -re {[%#$>]\s*$} { send "exit\r" }
        timeout { break }
    }
}
catch { wait }
exit 0
